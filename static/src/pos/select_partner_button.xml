<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-inherit="point_of_sale.SelectPartnerButton" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('text-action')]" position="after">
            <small t-if="props.partner and props.partner.vat"
                   class="partner-vat d-block text-muted lh-sm"
                   style="font-size: 11px;">
                <t t-esc="props.partner.vat"/>
            </small>
        </xpath>
    </t>

</templates>