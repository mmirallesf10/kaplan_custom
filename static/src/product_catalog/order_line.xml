<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-inherit="product.ProductCatalogOrderLine" t-inherit-mode="extension">
        <xpath expr="//span[hasclass('o_product_catalog_price')]" position="replace">
            <span class="o_product_catalog_price d-block">
                <t t-out="priceLabel"/>: <t t-out="price"/>
            </span>
            <span t-if="showPriceTotal" class="o_product_catalog_price_total d-block text-muted small">
                <t t-out="priceTotalLabel"/>: <t t-out="priceTotal"/>
            </span>
        </xpath>
    </t>

</templates>
