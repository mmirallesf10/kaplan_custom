<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.PartnerLine" t-inherit-mode="extension">
        <xpath expr="//td[hasclass('partner-line-email')]" position="before">
            <td class="partner-line-vat">
                <t t-esc="props.partner.vat or ''"/>
            </td>
        </xpath>
    </t>

    <t t-inherit="point_of_sale.PartnerListScreen" t-inherit-mode="extension">
        <xpath expr="//th[hasclass('partner-line-email')]" position="before">
            <th class="partner-line-vat">VAT / RIF</th>
        </xpath>
    </t>
</templates>