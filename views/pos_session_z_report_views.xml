<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pos_session_z_report_list" model="ir.ui.view">
        <field name="name">pos.session.z.report.list</field>
        <field name="model">pos.session.z.report</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="session_id"/>
                <field name="config_id"/>
                <field name="state" widget="badge" decoration-success="state == 'issued'" decoration-warning="state == 'draft'"/>
                <field name="order_count"/>
                <field name="total_amount" sum="1"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_pos_session_z_report_form" model="ir.ui.view">
        <field name="name">pos.session.z.report.form</field>
        <field name="model">pos.session.z.report</field>
        <field name="arch" type="xml">
            <form string="Reporte Z">
                <sheet>
                    <widget name="web_ribbon" title="Borrador" bg_color="text-bg-warning" invisible="state != 'draft'"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Número de Reporte Z"/></h1>
                    </div>
                    <group>
                        <group string="Sesión de caja">
                            <field name="session_id"/>
                            <field name="config_id"/>
                            <field name="date"/>
                            <field name="state"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Impresora fiscal (Printax)">
                            <field name="counter_x"/>
                            <field name="counter_z"/>
                            <field name="printer_serial"/>
                        </group>
                        <group string="Resumen al momento del corte">
                            <field name="order_count"/>
                            <field name="total_amount"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pos_session_z_report_search" model="ir.ui.view">
        <field name="name">pos.session.z.report.search</field>
        <field name="model">pos.session.z.report</field>
        <field name="arch" type="xml">
            <search string="Reportes Z">
                <field name="name"/>
                <field name="session_id"/>
                <field name="config_id"/>
                <filter string="Emitidos" name="emitidos" domain="[('state', '=', 'issued')]"/>
                <filter string="Borrador" name="borradores" domain="[('state', '=', 'draft')]"/>
                <separator/>
                <filter string="Propio" name="propio" domain="[('session_id.user_id', '=', uid)]"/>
                <filter string="Fecha de emisión" name="filter_date" date="date"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Punto de venta" name="group_by_config" context="{'group_by': 'config_id'}"/>
                    <filter string="Estado" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Fecha" name="group_by_date" context="{'group_by': 'date:week'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pos_session_z_report" model="ir.actions.act_window">
        <field name="name">Reportes Z</field>
        <field name="res_model">pos.session.z.report</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_pos_session_z_report_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No hay Reportes Z registrados</p>
            <p>El Reporte Z se genera al cerrar la sesión de caja y vincula de forma
            unívoca el corte fiscal de la impresora con su sesión.</p>
        </field>
    </record>

    <menuitem id="menu_pos_session_z_report"
              name="Reportes Z"
              parent="point_of_sale.menu_point_rep"
              action="action_pos_session_z_report"
              sequence="30"
              groups="point_of_sale.group_pos_user"/>

</odoo>
